# GL PRO — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores reais do Supabase.

# URL e chave pública (anon) do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# Domínio raiz do SaaS (usado para extrair o subdomínio do inquilino).
# Ex.: em produção "glpro.app"; em desenvolvimento local "glpro.local".
NEXT_PUBLIC_ROOT_DOMAIN="glpro.local"

# Chave de serviço do Supabase — SOMENTE no servidor. NUNCA exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
